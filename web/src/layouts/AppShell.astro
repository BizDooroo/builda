---
import "../styles/app.css";

const {
  title = "Builda",
  active = "",
  backHref = "",
  backLabel = "Back",
  headerMode = "default",
  chrome = true,
} = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem("builda.theme") || "system";
          const locale = localStorage.getItem("builda.locale") || "ko";
          const appliedTheme = ["dark", "light", "system"].includes(theme) ? theme : "system";
          document.documentElement.dataset.theme = appliedTheme;
          document.documentElement.dataset.colorScheme = appliedTheme === "dark" || (appliedTheme === "system" && matchMedia("(prefers-color-scheme: dark)").matches) ? "dark" : "light";
          document.documentElement.lang = ["en", "ko"].includes(locale) ? locale : "ko";
        } catch {
          document.documentElement.dataset.theme = "system";
          document.documentElement.dataset.colorScheme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
      })();
    </script>
  </head>
  <body data-header-mode={headerMode}>
    <a class="skip-link" href="#main-content" data-i18n="nav.skip">본문으로 건너뛰기</a>
    <header class="topbar">
      <div class="topbar-main">
        {
          backHref ? (
            <a class="button secondary compact" href={backHref} data-run-back={headerMode === "run-detail" ? "true" : undefined} data-i18n="nav.back">{backLabel}</a>
          ) : (
            <a class="brand" href="/" aria-label="Builda home" data-i18n-aria-label="brand.home">
              <span class="brand-mark" aria-hidden="true">B</span>
              <span>Builda</span>
            </a>
          )
        }
        {
          chrome && (
            <>
              <button class="menu-toggle secondary" type="button" data-nav-toggle aria-controls="primary-nav" aria-expanded="false" aria-label="Open navigation" data-i18n-aria-label="nav.open">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <path d="M4 7h16M4 12h16M4 17h16"></path>
                </svg>
              </button>
              <nav id="primary-nav" class="primary-nav" aria-label="Primary" data-i18n-aria-label="nav.primary" data-open="false">
                <a class:list={["nav-link", active === "jobs" && "active"]} aria-current={active === "jobs" ? "page" : undefined} href="/" data-i18n="nav.jobs">작업</a>
                <a class:list={["nav-link", active === "queue" && "active"]} aria-current={active === "queue" ? "page" : undefined} href="/queue" data-i18n="nav.queue">큐</a>
                <a class:list={["nav-link", active === "runs" && "active"]} aria-current={active === "runs" ? "page" : undefined} href="/runs" data-i18n="nav.runs">실행 기록</a>
                <a class:list={["nav-link", active === "catalogs" && "active"]} aria-current={active === "catalogs" ? "page" : undefined} href="/catalogs" data-i18n="nav.catalogs">카탈로그</a>
                <a class:list={["nav-link", active === "agents" && "active"]} aria-current={active === "agents" ? "page" : undefined} href="/agents" data-i18n="nav.agents">에이전트</a>
              </nav>
            </>
          )
        }
      </div>
      <div class="shell-context">
        <details class="account-menu">
          <summary class="account-toggle" aria-label="Account menu" data-i18n-aria-label="account.menu">
            <span data-i18n="account.menu">계정</span>
          </summary>
          <div class="account-popover">
            <span class="account-user" data-session-user hidden></span>
            <div class="preference-controls">
              <button class="secondary icon-toggle theme-toggle" type="button" data-theme-toggle aria-label="Color scheme" title="Color scheme">
                <span class="theme-icon" data-theme-icon aria-hidden="true"></span>
                <span class="sr-only" data-theme-label>system</span>
              </button>
              <button class="secondary locale-toggle" type="button" data-locale-toggle aria-label="Locale" title="Locale">
                <span data-locale-en>A</span><span aria-hidden="true">/</span><span data-locale-ko>한</span>
              </button>
            </div>
            {chrome && (
              <div class="account-actions">
                <a class:list={["button", "secondary", "compact", active === "settings" && "active"]} aria-current={active === "settings" ? "page" : undefined} href="/settings" data-i18n="nav.settings">설정</a>
                <button class="secondary compact" type="button" data-logout data-i18n="action.logout">로그아웃</button>
              </div>
            )}
            <span class="build-id" data-build-id hidden aria-live="polite"></span>
          </div>
        </details>
      </div>
    </header>
    <slot />
  </body>
</html>
