---
import "../styles/app.css";

const {
  title = "Builda",
  active = "",
  backHref = "",
  backLabel = "Back",
  headerMode = "default",
} = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body data-header-mode={headerMode}>
    <header class="topbar">
      <div class="topbar-main">
        {
          backHref ? (
            <a class="button secondary compact" href={backHref}>{backLabel}</a>
          ) : (
            <a class="brand" href="/" aria-label="Builda home">
              <span class="brand-mark" aria-hidden="true">B</span>
              <span>Builda</span>
            </a>
          )
        }
        <nav class="primary-nav" aria-label="Primary">
          <a class:list={["nav-link", active === "tasks" && "active"]} href="/">작업</a>
          <a class:list={["nav-link", active === "runs" && "active"]} href="/runs">실행 기록</a>
        </nav>
      </div>
      <div class="shell-context">
        <div class="server-meta" data-server-meta>Loading server...</div>
        <a class="button secondary compact" href="/config" data-config-link hidden>설정</a>
      </div>
    </header>
    <slot />
  </body>
</html>
