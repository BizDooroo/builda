---
import AppShell from "../../layouts/AppShell.astro";
---

<AppShell title="Config · Builda" backHref="/" backLabel="뒤로" active="config">
  <main class="workspace config-grid">
    <section class="page-heading">
      <div class="page-heading-copy">
        <p class="eyebrow" data-i18n="config.eyebrow">관리 화면</p>
        <h1 data-i18n="config.title">설정 편집기</h1>
        <p class="lead" data-i18n="config.lead">설정 편집이 활성화된 경우 활성 YAML 설정을 불러오고 검증한 뒤 저장합니다.</p>
      </div>
    </section>

    <section class="editor-panel">
      <div class="panel-head">
        <div class="panel-title">
          <h2>YAML</h2>
          <div class="meta" data-config-path></div>
        </div>
        <div class="auth-row">
          <input id="config-password" type="password" autocomplete="current-password" placeholder="비밀번호" aria-label="설정 비밀번호" data-i18n-placeholder="config.passwordPlaceholder" data-i18n-aria-label="config.passwordAria" />
          <button id="load-config" data-i18n="action.load">불러오기</button>
          <button id="save-config" class="danger" data-i18n="action.save">저장</button>
        </div>
      </div>
      <textarea id="config-editor" spellcheck="false"></textarea>
      <div id="config-status" class="editor-status" role="status" aria-live="polite"></div>
    </section>
  </main>

  <script>
    import "../../scripts/config.js";
  </script>
</AppShell>
