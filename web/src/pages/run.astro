---
import AppShell from "../layouts/AppShell.astro";
---

<AppShell title="Run · Builda" backHref="/runs" backLabel="뒤로" headerMode="run-detail">
  <main class="workspace run-detail-grid">
    <div id="run-status" class="notice" role="status" aria-live="polite" hidden></div>
    <section class="summary">
      <div class="summary-head">
        <div class="summary-title">
          <h1 id="run-title">Loading run</h1>
          <div class="meta" id="run-id"></div>
          <div class="param-list" id="params" aria-label="Run parameters" hidden></div>
        </div>
        <div class="summary-actions">
          <span class="badge" id="badge">loading</span>
          <button class="danger" id="cancel-run" type="button" hidden>취소</button>
        </div>
      </div>
      <details class="script-details">
        <summary>스크립트 보기</summary>
        <code id="script"></code>
      </details>
      <div class="times">
        <span id="requested">request -</span>
        <span id="started">start -</span>
        <span id="finished">finished -</span>
        <span id="canceled">cancelled -</span>
      </div>
    </section>
    <section class="log-panel">
      <div class="log-toolbar">
        <h2>로그</h2>
        <div class="toolbar">
          <button id="copy-log" class="secondary compact" type="button">로그 복사</button>
          <button id="follow-log" class="secondary compact active" type="button" aria-pressed="true">Follow on</button>
        </div>
      </div>
      <pre id="log" tabindex="0">Loading log...</pre>
    </section>
  </main>

  <script>
    import "../scripts/run-detail.js";
  </script>
</AppShell>
