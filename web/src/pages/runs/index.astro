---
import AppShell from "../../layouts/AppShell.astro";
---

<AppShell title="Runs · Builda" active="runs">
  <main class="workspace runs-workspace">
    <div id="runs-status" class="notice" role="status" aria-live="polite" hidden></div>
    <section class="page-heading">
      <div class="page-heading-copy">
        <p class="eyebrow" data-i18n="runs.eyebrow">실행 기록</p>
        <h1 data-i18n="runs.title">실행 기록과 로그를 확인하세요.</h1>
        <p class="lead" data-i18n="runs.lead">타임라인에서 실행을 고르고, 파라미터·스크립트·소요 시간·로그를 한 화면에서 확인합니다.</p>
      </div>
      <div class="toolbar">
        <a id="clear-run-filter" class="button secondary" href="/runs" hidden data-i18n="action.viewAllRuns">전체 실행 기록</a>
        <div id="run-count" class="meta">0 runs</div>
      </div>
    </section>

    <div class="runs-layout">
      <section class="panel">
        <div class="panel-head">
          <div class="panel-title">
            <h2 data-i18n="runs.timeline">타임라인</h2>
            <div id="run-filter" class="meta" hidden></div>
          </div>
          <div id="status-filters" class="status-filters" aria-label="Status filters" data-i18n-aria-label="runs.statusFilterAria"></div>
        </div>
        <div id="run-picker" class="run-picker" hidden>
          <select id="run-select" aria-label="Select run" data-i18n-aria-label="runs.selectAria"></select>
        </div>
        <div id="runs" class="run-list"></div>
      </section>

      <section class="inspector">
        <div id="summary" class="summary">
          <div class="empty" data-i18n="common.notSelected">실행을 선택하세요.</div>
        </div>
        <div class="log-panel">
          <div class="log-toolbar">
            <h2 data-i18n="log.heading">로그</h2>
            <div class="toolbar">
              <button id="copy-log" class="secondary compact" type="button" data-i18n="action.copyLog">로그 복사</button>
              <button id="delete-run" class="danger compact" type="button" data-i18n="action.deleteRun">실행 기록 삭제</button>
              <button id="follow-log" class="secondary compact active" type="button" aria-pressed="true">Follow</button>
            </div>
          </div>
          <pre id="log" tabindex="0" data-i18n="log.empty">실행을 선택하면 로그가 표시됩니다.</pre>
        </div>
      </section>
    </div>
  </main>

  <div id="run-modal" class="modal-shell" hidden>
    <form id="run-form" class="modal" role="dialog" aria-modal="true" aria-labelledby="run-modal-title" tabindex="-1">
      <div class="modal-head">
        <div class="modal-title">
          <h2 id="run-modal-title" data-i18n="action.run">작업 실행</h2>
          <div id="run-modal-meta" class="meta"></div>
        </div>
        <button class="secondary icon-button" type="button" data-close-run-modal aria-label="닫기" title="닫기" data-i18n-aria-label="action.close" data-i18n-title="action.close">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>
      <div id="run-modal-fields" class="modal-fields"></div>
      <div class="task-actions">
        <button class="secondary" type="button" data-close-run-modal data-i18n="action.cancel">취소</button>
        <button id="run-modal-submit" type="submit" data-i18n="action.run">실행</button>
      </div>
    </form>
  </div>

  <script>
    import "../../scripts/runs.js";
  </script>
</AppShell>
