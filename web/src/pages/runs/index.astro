---
import AppShell from "../../layouts/AppShell.astro";
---

<AppShell title="History · Builda" active="runs">
  <main id="main-content" class="workspace runs-workspace">
    <div id="runs-status" class="notice" role="status" aria-live="polite" hidden></div>
    <section class="page-heading">
      <div class="page-heading-copy">
        <p class="eyebrow" data-i18n="runs.eyebrow">실행 기록</p>
        <h1 data-i18n="runs.title">실행 기록</h1>
        <p class="lead" data-i18n="runs.lead">기록을 걸러 보고 로그를 따라갑니다.</p>
      </div>
      <div class="toolbar">
        <div id="run-count" class="meta" aria-live="polite">0</div>
      </div>
    </section>

    <section class="panel">
      <div id="run-filters" class="filter-bar"></div>
    </section>

    <div class="runs-layout">
      <section class="panel run-list-panel" aria-label="Run list" data-i18n-aria-label="runs.timeline">
        <div class="panel-head">
          <div class="panel-title">
            <h2 data-i18n="runs.timeline">타임라인</h2>
          </div>
        </div>
        <div id="runs" class="run-list" aria-busy="true"><div class="empty" data-i18n="common.loading">불러오는 중</div></div>
        <div class="run-pagination">
          <button id="previous-runs" class="secondary compact" type="button" data-i18n="action.previous">이전</button>
          <span id="run-page" class="meta" aria-live="polite">1 / 1</span>
          <button id="next-runs" class="secondary compact" type="button" data-i18n="action.next">다음</button>
        </div>
      </section>

      <section class="inspector">
        <div id="summary" class="summary">
          <div class="empty" data-i18n="common.notSelected">실행을 선택하세요.</div>
        </div>
        <div class="log-panel">
          <div class="log-toolbar">
            <h2 data-i18n="log.heading">로그</h2>
            <div class="toolbar">
              <button id="copy-log" class="secondary compact" type="button" data-i18n="action.copyLog">로그 복사</button>
              <button id="wrap-log" class="secondary compact" type="button" aria-pressed="true" data-i18n="log.wrapOn">줄바꿈 켜짐</button>
              <button id="follow-log" class="secondary compact active" type="button" aria-pressed="true" data-i18n="action.followOn">Follow 켜짐</button>
            </div>
          </div>
          <pre id="log" tabindex="0" aria-label="Log" data-i18n-aria-label="log.heading">실행을 선택하면 로그가 표시됩니다.</pre>
          <div id="log-update" class="sr-only" role="status" aria-live="polite"></div>
        </div>
      </section>
    </div>
  </main>

  <script>
    import "../../scripts/runs.js";
  </script>
</AppShell>
