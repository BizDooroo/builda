---
import AppShell from "../layouts/AppShell.astro";
---

<AppShell title="Jobs · Builda" active="jobs">
  <main class="workspace">
    <div id="jobs-status" class="notice" role="status" aria-live="polite" hidden></div>
    <section class="page-heading">
      <div class="page-heading-copy">
        <p class="eyebrow" data-i18n="jobs.eyebrow">빌드 작업</p>
        <h1 data-i18n="jobs.title">작업</h1>
        <p class="lead" data-i18n="jobs.lead">등록된 작업만 실행됩니다.</p>
      </div>
      <div class="toolbar">
        <button id="new-job" type="button" data-i18n="action.newJob">작업 추가</button>
      </div>
    </section>

    <section id="job-editor" class="panel" hidden>
      <div class="panel-head">
        <div class="panel-title">
          <h2 id="job-editor-title">작업 추가</h2>
        </div>
        <div class="toolbar">
          <button id="close-job-editor" class="secondary compact" type="button" data-i18n="action.close">닫기</button>
        </div>
      </div>
      <form id="job-form" class="form-grid">
        <div id="job-fields" class="form-grid"></div>
        <div class="panel-title">
          <h3 data-i18n="field.parameters">파라미터</h3>
        </div>
        <div id="job-parameters" class="repeater"></div>
        <div class="task-actions">
          <button id="add-parameter" class="secondary" type="button" data-i18n="action.add">추가</button>
          <button type="submit" data-i18n="action.save">저장</button>
        </div>
      </form>
    </section>

    <section class="panel">
      <div class="panel-head">
        <div class="panel-title">
          <h2 data-i18n="nav.jobs">작업</h2>
        </div>
      </div>
      <div id="jobs" class="record-list"></div>
    </section>
  </main>

  <div id="run-modal" class="modal-shell" hidden>
    <form id="run-form" class="modal" role="dialog" aria-modal="true" aria-labelledby="run-modal-title" tabindex="-1">
      <div class="modal-head">
        <div class="modal-title">
          <h2 id="run-modal-title" data-i18n="action.execute">실행</h2>
          <div id="run-modal-preview" class="param-list"></div>
        </div>
        <button class="secondary icon-button" type="button" data-close-run-modal aria-label="닫기" title="닫기" data-i18n-aria-label="action.close" data-i18n-title="action.close">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>
      <div id="run-modal-fields" class="modal-fields"></div>
      <div class="task-actions">
        <button class="secondary" type="button" data-close-run-modal data-i18n="action.cancel">취소</button>
        <button type="submit" data-i18n="action.execute">실행</button>
      </div>
    </form>
  </div>

  <script>
    import "../scripts/jobs.js";
  </script>
</AppShell>
