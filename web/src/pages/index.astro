---
import AppShell from "../layouts/AppShell.astro";
---

<AppShell title="Builda" active="tasks">
  <main class="workspace home-workspace">
    <div id="home-status" class="notice" role="status" aria-live="polite" hidden></div>
    <section class="page-heading">
      <div class="page-heading-copy">
        <p class="eyebrow">Local task runner</p>
        <h1>작업을 실행하고 큐 상태를 확인하세요.</h1>
        <p class="lead">Builda는 설정된 작업만 한 번에 하나씩 실행하고, 모든 실행을 로그와 연결합니다.</p>
      </div>
      <div class="toolbar">
        <a class="button secondary" href="/runs">전체 실행 기록</a>
      </div>
    </section>

    <section class="metric-strip" aria-label="Overview">
      <div class="metric">
        <span class="metric-label">작업</span>
        <span id="task-count" class="metric-value">0</span>
      </div>
      <div class="metric">
        <span class="metric-label">실행 중</span>
        <span id="running-count" class="metric-value">0</span>
      </div>
      <div class="metric">
        <span class="metric-label">대기</span>
        <span id="queued-count" class="metric-value">0</span>
      </div>
      <div class="metric">
        <span class="metric-label">최근 결과</span>
        <span id="latest-status" class="metric-value">-</span>
      </div>
    </section>

    <div class="home-layout">
      <section class="panel">
        <div class="panel-head">
          <div class="panel-title">
            <h2>작업</h2>
            <div class="meta">설정 파일에 등록된 명령만 실행</div>
          </div>
        </div>
        <div id="tasks" class="task-list"></div>
      </section>

      <section class="panel">
        <div class="panel-head">
          <div class="panel-title">
            <h2>최근 실행</h2>
            <div id="run-count" class="count">0 runs</div>
          </div>
          <div class="run-head-actions">
            <a class="button secondary" href="/runs">전체 보기</a>
          </div>
        </div>
        <div id="runs" class="run-list"></div>
      </section>
    </div>
  </main>

  <div id="run-modal" class="modal-shell" hidden>
    <form id="run-form" class="modal" role="dialog" aria-modal="true" aria-labelledby="run-modal-title" tabindex="-1">
      <div class="modal-head">
        <div class="modal-title">
          <h2 id="run-modal-title">작업 실행</h2>
          <div id="run-modal-meta" class="meta"></div>
        </div>
        <button class="secondary icon-button" type="button" data-close-run-modal aria-label="닫기" title="닫기">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>
      <div id="run-modal-fields" class="modal-fields"></div>
      <div class="task-actions">
        <button class="secondary" type="button" data-close-run-modal>취소</button>
        <button id="run-modal-submit" type="submit">실행</button>
      </div>
    </form>
  </div>

  <script>
    import "../scripts/home.js";
  </script>
</AppShell>
