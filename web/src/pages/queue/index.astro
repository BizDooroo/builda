---
import AppShell from "../../layouts/AppShell.astro";
---

<AppShell title="Queue · Builda" active="queue">
  <main id="main-content" class="workspace">
    <div id="queue-status" class="notice" role="status" aria-live="polite" hidden></div>
    <section class="page-heading">
      <div class="page-heading-copy">
        <p class="eyebrow" data-i18n="queue.eyebrow">중앙 큐</p>
        <h1 data-i18n="queue.title">큐</h1>
        <p class="lead" data-i18n="queue.lead">하나의 큐가 모든 에이전트에 일을 보냅니다.</p>
      </div>
      <div class="toolbar">
        <button id="cancel-selected" class="danger" type="button" disabled data-i18n="action.cancelSelected">선택 취소</button>
        <button id="refresh" class="secondary" type="button" data-i18n="action.refresh">새로고침</button>
      </div>
    </section>

    <section class="panel">
      <div class="panel-head">
        <div class="panel-title">
          <h2 data-i18n="queue.active">실행 중</h2>
        </div>
      </div>
      <div id="active" class="record-list" aria-busy="true"><div class="empty" data-i18n="common.loading">불러오는 중</div></div>
    </section>

    <section class="panel">
      <div class="panel-head">
        <div class="panel-title">
          <h2 data-i18n="queue.waiting">대기 중</h2>
        </div>
      </div>
      <div id="queue" class="record-list" aria-busy="true"><div class="empty" data-i18n="common.loading">불러오는 중</div></div>
    </section>
  </main>

  <script>
    import "../../scripts/queue.js";
  </script>
</AppShell>
